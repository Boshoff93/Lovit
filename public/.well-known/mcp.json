{
  "name": "gruvi",
  "title": "Gruvi: Content distribution for agents",
  "version": "2.1.0",
  "description": "Publish finished videos and photo carousels, bulk schedule posts, read engagement analytics and verify per-platform delivery.",
  "documentation_url": "https://agentgruvi.com/docs/agent-integration",
  "transport": "stdio",
  "installation": {
    "runtime": "node >=20",
    "command": "npx",
    "args": [
      "--yes",
      "--package=@agent-gruvi/gruvi-mcp-server@2.1.0",
      "gruvi-mcp"
    ],
    "environment_variables": [
      {
        "name": "GRUVI_API_KEY",
        "required": true,
        "secret": true,
        "description": "Create your key at https://agentgruvi.com/agents"
      },
      {
        "name": "GRUVI_API_URL",
        "default": "https://api.agentgruvi.com"
      }
    ]
  },
  "tools": [
    "gruvi_login",
    "gruvi_get_plans",
    "gruvi_create_checkout",
    "gruvi_get_billing_status",
    "gruvi_get_user_info",
    "gruvi_get_social_accounts",
    "gruvi_upload_video",
    "gruvi_get_video_upload_url",
    "gruvi_finalize_video_upload",
    "gruvi_list_videos",
    "gruvi_get_video",
    "gruvi_upload_thumbnail",
    "gruvi_update_post_metadata",
    "gruvi_publish_post",
    "gruvi_get_post_status",
    "gruvi_schedule_post",
    "gruvi_list_scheduled_posts",
    "gruvi_get_scheduled_post",
    "gruvi_delete_scheduled_post",
    "gruvi_get_analytics",
    "gruvi_bulk_schedule_videos",
    "gruvi_list_carousels",
    "gruvi_upload_carousel",
    "gruvi_publish_carousel",
    "gruvi_schedule_carousel",
    "gruvi_get_carousel_publication"
  ],
  "resources": [
    "gruvi://docs/quickstart",
    "gruvi://docs/api"
  ],
  "http_api": "https://agentgruvi.com/openapi.json",
  "authentication": {
    "type": "api_key",
    "account_setup": "https://agentgruvi.com/agents"
  },
  "note": "Official npm package and MCP Registry listing for the local stdio server. This setup does not expose a hosted HTTP MCP endpoint.",
  "registry_name": "com.agentgruvi/gruvi",
  "npm_package": "@agent-gruvi/gruvi-mcp-server",
  "registry_url": "https://registry.modelcontextprotocol.io/v0.1/servers/com.agentgruvi%2Fgruvi/versions/2.1.0"
}
